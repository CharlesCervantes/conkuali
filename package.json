{
  "name": "conkuali",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --import ./tests/setup/unitarias.mjs --test \"tests/{dashboard,contabilidad,seguridad,cobro,reposiciones}/**/*.test.ts\"",
    "test:integracion": "node --conditions=react-server --import tsx --import ./tests/setup/integracion.mjs --test --test-concurrency=1 \"tests/integracion/**/*.test.ts\"",
    "test:integracion:preparar": "node --import tsx scripts/pruebas/preparar-base-pruebas.ts",
    "test:integracion:migrar": "node --import tsx scripts/pruebas/migrar-base-pruebas.ts",
    "test:integracion:limpiar": "node --import tsx scripts/pruebas/limpiar-base-pruebas.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@napi-rs/canvas": "^1.0.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.6.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "openai": "^7.25.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
