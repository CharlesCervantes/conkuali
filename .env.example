# Copia este archivo a .env y completa los valores reales. Nunca subas .env
# (ya está en .gitignore) — este archivo es solo la plantilla, sin secretos.

# --- Base de datos (Neon Postgres) ---------------------------------------
# Conexión pooled — la usa la aplicación en tiempo de ejecución
# (lib/server/db.ts, vía @prisma/adapter-pg). En Neon es la URL que incluye
# "-pooler" en el host.
DATABASE_URL=

# Conexión directa (sin pooler) — la usa únicamente el CLI de Prisma
# (prisma migrate deploy/dev, prisma studio, ver prisma.config.ts). Las
# migraciones necesitan bloqueos que el pooler de Neon no soporta.
DIRECT_URL=

# --- Almacenamiento de archivos (Cloudflare R2) --------------------------
# Nombre del bucket privado en R2 (evidencias, recibos, comprobantes,
# facturas, logos — ver lib/server/archivos.ts).
R2_BUCKET_NAME=

# Endpoint S3-compatible de tu cuenta de Cloudflare R2, con el formato:
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Credenciales del token de acceso R2 (Cloudflare dashboard → R2 → Manage
# API Tokens). Deben tener permiso de lectura/escritura solo sobre el bucket
# de arriba.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Siembra inicial (prisma/seed.ts) ------------------------------------
# Solo se usan al correr `npm run db:seed` manualmente — nunca en tiempo de
# ejecución de la aplicación. Cada persona se crea únicamente si su variable
# está definida; deja en blanco (o sin declarar) la que todavía no tenga
# correo real asignado.
SEED_EMAIL_MASTER=
SEED_EMAIL_SERGIO=
SEED_EMAIL_CHARLES=
SEED_EMAIL_ANDRES=
