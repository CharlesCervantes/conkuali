# Copia este archivo a .env y completa los valores reales. Nunca subas .env
# (ya está en .gitignore) — este archivo es solo la plantilla, sin secretos.

# --- Base de datos (Neon Postgres) ---------------------------------------
# Conexión pooled — la usa la aplicación en tiempo de ejecución
# (lib/server/db.ts, vía @prisma/adapter-pg). En Neon es la URL que incluye
# "-pooler" en el host.
DATABASE_URL=

# Conexión directa (sin pooler) — la usa únicamente el CLI de Prisma
# (prisma migrate deploy/dev, prisma studio, ver prisma.config.ts). Las
# migraciones necesitan bloqueos que el pooler de Neon no soporta.
DIRECT_URL=

# --- Almacenamiento de archivos (Cloudflare R2) --------------------------
# Nombre del bucket privado en R2 (evidencias, recibos, comprobantes,
# facturas, logos — ver lib/server/archivos.ts).
R2_BUCKET_NAME=

# Endpoint S3-compatible de tu cuenta de Cloudflare R2, con el formato:
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Credenciales del token de acceso R2 (Cloudflare dashboard → R2 → Manage
# API Tokens). Deben tener permiso de lectura/escritura solo sobre el bucket
# de arriba.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Siembra inicial (prisma/seed.ts) ------------------------------------
# Solo se usan al correr `npm run db:seed` manualmente — nunca en tiempo de
# ejecución de la aplicación. Cada persona se crea únicamente si su variable
# está definida; deja en blanco (o sin declarar) la que todavía no tenga
# correo real asignado.
SEED_EMAIL_MASTER=
SEED_EMAIL_SERGIO=
SEED_EMAIL_CHARLES=
SEED_EMAIL_ANDRES=

# --- ARQENTO IA / Captura inteligente de documentos ----------------------
# Solo se usan cuando Master habilita ARQENTO IA para una Empresa
# (inteligenciaHabilitada = false por omisión). Con la IA apagada pueden
# quedar vacías.
# Llave del proveedor de IA (lib/server/inteligencia/interpretador-openai.ts).
OPENAI_API_KEY=
# Interruptor global de emergencia de la estrategia visual (PDF escaneado /
# imagen). "false" la apaga para todas las Empresas.
ARQENTO_VISION_HABILITADA=
# Secreto del endpoint /api/cron/procesar-documentos (Authorization: Bearer
# <CRON_SECRET>). Necesario solo cuando se active el cron en vercel.json.
CRON_SECRET=

# --- Pruebas de integración (npm run test:integracion) -------------------
# Solo en tu terminal local, nunca en Vercel ni en este archivo con valor:
# PostgreSQL LOCAL dedicado (localhost / 127.0.0.1), base terminada en
# "_test" y marcada con npm run test:integracion:preparar. Los scripts
# rechazan cualquier otra conexión (ver tests/helpers/base-de-pruebas.ts).
TEST_DATABASE_URL=
