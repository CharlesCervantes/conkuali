// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Módulo Usuarios / Login
// Ver /docs/arquitectura/00-decisiones-fundamentales.md y
// /docs/negocio/00-indice.md para las reglas de negocio detrás de este esquema.
// ---------------------------------------------------------------------------

enum RolUsuario {
  MASTER // rol de plataforma, fuera de cualquier Empresa (empresaId = null)
  DIRECTOR
  ADMINISTRADOR
  SUPERVISOR
}

enum AccionAuditoria {
  CREAR
  EDITAR
  CONFIRMAR
  RECHAZAR
  CAMBIAR_ESTATUS
  ACTIVAR
  DESACTIVAR
  ELIMINAR
}

model Empresa {
  id              String   @id @default(cuid())
  nombre          String
  razonSocial     String?
  rfc             String?
  colorPrimario   String   @default("#0f172a")
  colorSecundario String   @default("#64748b")
  logoRef         String?
  activa          Boolean  @default(true)
  // Capacidad transversal (no es un Modulo/pantalla) — si la Empresa contrató
  // o no las capas privadas del sistema. Seguro por defecto: una Empresa
  // nueva nunca la recibe automáticamente, Master debe habilitarla
  // explícitamente (decisión de sesión, Portal Master). Se combina con el
  // permiso de rol existente en puedeVerInformacionPrivada — nunca sustituye
  // esa verificación, la complementa (ver lib/server/permisos.ts).
  privadoHabilitado Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan   Plan?   @relation(fields: [planId], references: [id])
  planId String?

  // Override explícito por tenant sobre los módulos de su Plan — puede tanto
  // conceder un módulo fuera del Plan como apagar uno que el Plan sí incluye.
  // Sin fila aquí para un módulo = se hereda el Plan tal cual. Resolución
  // centralizada en empresaTieneModulo (lib/server/permisos.ts), nunca se
  // evalúa dispersa en otro lugar.
  modulosOverride EmpresaModulo[]

  // Recibos de pago (sección "Recibo de Pago" de 02-control-de-obra.md) — el
  // folio es único por empresa, no por proyecto. `ultimoFolioRecibo` es el
  // contador atómico (se incrementa con `increment` dentro de la misma
  // transacción que crea el ReciboPago — Postgres bloquea la fila hasta que
  // esa transacción termina, así que dos generaciones simultáneas nunca
  // pueden sacar el mismo folio). Los demás campos son config simple de
  // marca/leyenda del recibo — no ameritan una entidad de Configuración
  // aparte, se guardan igual que colorPrimario/colorSecundario/logoRef.
  ultimoFolioRecibo    Int     @default(0)
  reciboTitulo         String  @default("ESTIMACIÓN DE CONTRATISTA")
  reciboLeyenda        String?
  reciboRazonSocial    String?
  reciboMostrarDetalle Boolean @default(true)
  reciboMostrarPU      Boolean @default(true)
  // Bloque de declaraciones/conformidad — toggle independiente de si hay
  // texto guardado (permite redactarlo y decidir después si se muestra, sin
  // borrarlo) y título del bloque, separado de reciboTitulo (que es el
  // título del documento completo). Config de Empresa, Master-only (Portal
  // Master → Empresas → Documentos, septiembre 2026) — mismo patrón que sus
  // hermanos de arriba, sin entidad de Configuración aparte.
  reciboMostrarLeyenda Boolean @default(true)
  reciboTituloLeyenda  String  @default("DECLARACIONES Y ACEPTACIÓN DE LA ESTIMACIÓN")

  // Gastos de Obra (sección "Gastos de Obra" de 04-modulo-control-de-obra.md)
  // — mismo mecanismo atómico que ultimoFolioRecibo, folio único por empresa.
  ultimoFolioReposicion  Int @default(0)
  ultimoFolioOrdenCompra Int @default(0)

  dominiosCorreo         DominioCorreo[]
  usuarios               Usuario[]
  registros              RegistroAuditoria[]
  proyectos              Proyecto[]
  beneficiarios          Beneficiario[]
  semanas                Semana[]
  avancesConcepto        AvanceConcepto[]
  cierresSemana          CierreSemanaProyecto[]
  cortesSemana           CorteSemanal[]
  recibosPago            ReciboPago[]
  estimacionesCliente    EstimacionCliente[]
  movimientosFinancieros MovimientoFinancieroCliente[]
  gastosObra             GastoObra[]
  reposicionesGastos     ReposicionGastos[]
  ordenesCompra          OrdenCompra[]
  requisiciones          Requisicion[]
  gastosRecurrentes      GastoRecurrente[]
  mediosFinancieros      MedioFinanciero[]
  egresos                Egreso[]
  ingresos               Ingreso[]
  facturas               Factura[]

  @@map("empresas")
}

// Dato secundario/opcional: solo empresas con dominio de correo propio lo usan,
// como ayuda para asignar automáticamente la empresa al invitar un usuario nuevo
// bajo ese dominio. La relación Usuario -> Empresa nunca se infiere de aquí.
model DominioCorreo {
  id        String   @id @default(cuid())
  dominio   String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  createdAt DateTime @default(now())

  @@map("dominios_correo")
}

model Plan {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  empresas Empresa[]
  modulos  PlanModulo[]

  @@map("planes")
}

// Catálogo de módulos del sistema (ej. "reporte_general", "control_prestamos").
model Modulo {
  id     String @id @default(cuid())
  clave  String @unique
  nombre String

  planes    PlanModulo[]
  empresas  EmpresaModulo[]

  @@map("modulos")
}

model PlanModulo {
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId   String
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  moduloId String

  @@id([planId, moduloId])
  @@map("plan_modulos")
}

// Override de tenant sobre el Plan — ver comentario en Empresa.modulosOverride.
// habilitado=true sobre un módulo fuera del Plan = capacidad adicional;
// habilitado=false sobre un módulo que el Plan sí incluye = apagado específico
// para esa Empresa. Borrar la fila = volver a heredar el Plan tal cual.
model EmpresaModulo {
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId  String
  modulo     Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  moduloId   String
  habilitado Boolean

  @@id([empresaId, moduloId])
  @@map("empresa_modulos")
}

model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // null únicamente para rol MASTER (usuario de plataforma, sin empresa).
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  empresaId String?

  sesiones  Sesion[]
  registros RegistroAuditoria[]

  aditivasSolicitadas    Aditiva[]              @relation("AditivasSolicitadas")
  aditivasAutorizadas    Aditiva[]              @relation("AditivasAutorizadas")
  movimientosEnviados    MovimientoSemanal[]    @relation("MovimientosEnviados")
  movimientosAprobados   MovimientoSemanal[]    @relation("MovimientosAprobados")
  movimientosFondoPuente MovimientoSemanal[]    @relation("FondoPuente")
  movimientosLiquidados  MovimientoSemanal[]    @relation("MovimientoLiquidado")
  comentarios            ComentarioMovimiento[]
  avancesRegistrados     AvanceConcepto[]       @relation("AvanceRegistrado")
  avancesAprobados       AvanceConcepto[]       @relation("AvanceAprobado")

  cierresSemanaGenerados  CierreSemanaProyecto[] @relation("CierreSemanaGenerado")
  cierresSemanaReabiertos CierreSemanaProyecto[] @relation("CierreSemanaReabierto")
  cortesSemanaGenerados   CorteSemanal[]         @relation("CorteSemanalGenerado")
  proyectosSupervisados   Proyecto[]             @relation("ProyectoSupervisor")

  recibosGenerados       ReciboPago[] @relation("ReciboPagoGenerado")
  recibosEvidenciaSubida ReciboPago[] @relation("ReciboPagoEvidenciaSubida")

  estimacionesClienteGeneradas             EstimacionCliente[]           @relation("EstimacionClienteGenerada")
  estimacionesClienteEmitidas              EstimacionCliente[]           @relation("EstimacionClienteEmitida")
  estimacionesClienteCapaGeneradas         EstimacionClienteCapa[]       @relation("EstimacionClienteCapaGenerada")
  estimacionesClienteCapaEmitidas          EstimacionClienteCapa[]       @relation("EstimacionClienteCapaEmitida")
  movimientosFinancierosClienteRegistrados MovimientoFinancieroCliente[]
  movimientosFinancierosClienteCancelados  MovimientoFinancieroCliente[] @relation("MovimientoFinancieroClienteCancelado")

  gastosCapturados GastoObra[] @relation("GastoCapturado")
  gastosRevisados  GastoObra[] @relation("GastoRevisado")

  reposicionesCreadas   ReposicionGastos[] @relation("ReposicionCreada")
  reposicionesRevisadas ReposicionGastos[] @relation("ReposicionRevisada")

  ordenesCompraCreadas     OrdenCompra[] @relation("OCCreada")
  ordenesCompraAutorizadas OrdenCompra[] @relation("OCAutorizada")
  ordenesCompraRecibidas   OrdenCompra[] @relation("OCRecibida")

  requisicionesSolicitadas Requisicion[] @relation("RequisicionSolicitada")
  requisicionesRevisadas   Requisicion[] @relation("RequisicionRevisada")
  cotizacionesRegistradas  Cotizacion[]  @relation("CotizacionRegistrada")

  gastosRecurrentesCreados     GastoRecurrente[] @relation("GastoRecurrenteCreado")
  abonosReposicionRegistrados  AbonoReposicion[] @relation("AbonoReposicionRegistrado")

  egresosRegistrados  Egreso[]  @relation("EgresoRegistrado")
  ingresosRegistrados Ingreso[] @relation("IngresoRegistrado")
  facturasSubidas     Factura[] @relation("FacturaSubida")

  // Vínculo opcional con la identidad de pago (Beneficiario) de esta misma
  // persona — ver Beneficiario.usuarioId para la relación completa. Un
  // Usuario puede no tener beneficiario relacionado (rol de plataforma,
  // alguien que nunca recibe pagos) o tenerlo (ej. un Supervisor a quien
  // también se le reponen gastos personales).
  beneficiario Beneficiario?

  // Preferencia personal — restringe temporalmente el acceso a la capa
  // privada de Control de Obra sin tocar el rol ni sus permisos operativos
  // (solo Administrador/Director la usan; ver puedeVerInformacionPrivada en
  // lib/server/permisos.ts). Nunca es una fuente de permiso por sí sola:
  // combinada siempre con el permiso real de rol, nunca al revés. Default
  // `true` para que ningún usuario existente pierda acceso al migrar.
  vistaPrivadaActiva Boolean @default(true)

  // true justo después de que Master (u otro flujo de alta) crea la cuenta
  // con una contraseña temporal generada por el sistema — mientras sea true,
  // el usuario solo puede acceder a /nueva-password (cambio obligatorio) o
  // cerrar sesión, nunca al resto de la app (ver app/(app)/layout.tsx y
  // app/(proyecto)/control-de-obra/[id]/layout.tsx). Se limpia al completar
  // el cambio de contraseña. Default `false` — ningún usuario existente
  // queda bloqueado al migrar.
  debeCambiarPassword Boolean @default(false)

  @@index([empresaId])
  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  // Se guarda el hash del token, nunca el token en claro (igual que un password).
  tokenHash String   @unique
  expiraEn  DateTime
  creadaEn  DateTime @default(now())

  @@map("sesiones")
}

// Bitácora general del sistema (principio no negociable: toda acción relevante
// se registra y nunca se elimina). Reutilizable por cualquier módulo futuro.
model RegistroAuditoria {
  id            String          @id @default(cuid())
  empresa       Empresa?        @relation(fields: [empresaId], references: [id])
  empresaId     String?
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id])
  usuarioId     String?
  entidad       String
  entidadId     String
  accion        AccionAuditoria
  valorAnterior Json?
  valorNuevo    Json?
  createdAt     DateTime        @default(now())

  @@index([entidad, entidadId])
  @@map("registros_auditoria")
}

// ---------------------------------------------------------------------------
// Módulo Reporte General
// Ver /docs/negocio/03-modulo-reporte-general.md para las reglas de negocio
// detrás de este esquema (revisado y aprobado en sesión con Charles).
// ---------------------------------------------------------------------------

enum TipoBeneficiario {
  CONTRATISTA
  PROVEEDOR
  ADMINISTRACION
}

enum TipoProyecto {
  FORMAL // obra formal
  MOMENTANEA // obra momentánea, reporte simplificado del supervisor
  OFICINA // partición de gastos administrativos generales, no es una obra real
}

enum EstatusProyecto {
  ACTIVO
  PAUSADO
  CERRADO
  CANCELADO
}

// Flujo de autorización del movimiento — independiente del estado de pago.
enum EstatusAprobacion {
  PENDIENTE_VALIDACION // capturado por Supervisor, aún no oficial
  APROBADO // capturado por Administrador/Director, o validado por Administrador
  RECHAZADO
  POSPUESTO // no se pagó esta semana, continúa la siguiente
  CANCELADO
}

// Estado financiero/color del Reporte General (02-control-de-obra.md).
// Solo tiene sentido una vez que estatusAprobacion = APROBADO.
enum EstatusPago {
  SIN_MOVIMIENTO // Neutral
  PENDIENTE_PAGO // Rojo
  PAGADO_PUENTE // Naranja — cubierto con fondos de Sergio o de la empresa
  LIQUIDADO // Verde
}

// De dónde sale un MovimientoSemanal — ver el campo `origen` en el modelo.
enum OrigenMovimientoSemanal {
  CORTE_CONTRATISTA
  REPOSICION_GASTOS
  ORDEN_COMPRA
  MANUAL
}

enum EstatusAditiva {
  PENDIENTE
  AUTORIZADA
  RECHAZADA
}

enum EstatusSemana {
  ABIERTA
  CERRADA
}

// Precio Alzado: costo (contratista+materiales+indirectos+herramienta) + %
// utilidad → precio cliente. Administración: no usa indirectos/herramienta,
// aplica % administración sobre el costo real. Ver
// docs/negocio/04-modulo-control-de-obra.md sección 49.9.
enum EsquemaContractual {
  PRECIO_ALZADO
  ADMINISTRACION
}

model Proyecto {
  id          String          @id @default(cuid())
  empresa     Empresa         @relation(fields: [empresaId], references: [id])
  empresaId   String
  nombre      String
  tipo        TipoProyecto    @default(FORMAL)
  estatus     EstatusProyecto @default(ACTIVO)
  fechaInicio DateTime?
  fechaCierre DateTime?

  // Administración de proyectos (Control de Obra — Etapa 1). `cliente` es
  // texto libre por ahora, sin catálogo propio todavía. `numeroContrato` es el
  // contrato principal del proyecto con el cliente — no el de los
  // contratistas (eso se resuelve después con ContratoContratista, ver
  // docs/negocio/04-modulo-control-de-obra.md sección 49).
  cliente              String?
  ubicacion            String?
  numeroContrato       String?
  descripcion          String?
  notas                String?
  fechaEstimadaTermino DateTime?

  // Supervisor responsable del proyecto (Contratistas: Control Contractual +
  // Estimaciones, septiembre 2026) — opcional, nunca inferido de
  // CierreSemanaProyecto.cerradoPor (eso lo cierra Administrador/Director,
  // nunca un Supervisor — ver puedeCerrarSemana) ni de ningún otro usuario
  // "de paso". Se congela por nombre en ReciboPago.configuracionSnapshot al
  // generar el documento: reasignar el Supervisor del proyecto después nunca
  // altera un documento ya generado.
  supervisorUsuario   Usuario? @relation("ProyectoSupervisor", fields: [supervisorUsuarioId], references: [id])
  supervisorUsuarioId String?

  // Imagen de portada (Inicio: dashboard ejecutivo, agosto 2026) — mismo
  // patrón que GastoObra.ticketRef/ReciboPago.archivoEvidenciaRef: solo se
  // guarda la referencia de almacenamiento + nombre original (Cloudflare R2
  // vía subirArchivo(), lib/server/archivos.ts), nunca el binario. null =
  // placeholder en la UI.
  imagenRef    String?
  imagenNombre String?

  // Contrato General (sección 49.9) — null = todavía sin definir. No se
  // infiere para proyectos existentes; Administrador/Director lo asigna a
  // propósito. Solo uno de los dos porcentajes default aplica, según el
  // esquema — se guardan separados (nunca un campo genérico) para que su
  // significado nunca dependa de una lectura implícita del esquema.
  esquemaContractual              EsquemaContractual?
  porcentajeUtilidadDefault       Decimal?            @db.Decimal(5, 2)
  porcentajeAdministracionDefault Decimal?            @db.Decimal(5, 2)

  // Override privado del %Administración de arriba — mismo patrón que
  // Concepto.precioUnitarioContratistaPrivado: null = todavía no se editó
  // aquí, el motor privado (Cliente Priv./Contrato General Privado) usa el
  // %Administración por default de arriba; una vez editado, independiente,
  // nunca se resincroniza. Necesario porque ese default alimenta también al
  // motor OPERATIVO (Cliente/Contrato General normal, que no es privado —
  // ver comentario en calcularPrecioOperativoConcepto), y el valor comercial
  // que se le aplica al cliente puede diferir del que se usa internamente
  // (decisión de sesión, agosto 2026). %Utilidad no tiene equivalente aquí
  // porque ya es 100% privada — el motor operativo nunca la usa.
  porcentajeAdministracionPrivadoDefault Decimal? @db.Decimal(5, 2)

  // Contador atómico de Estimación Cliente (sección "Cliente" de
  // 04-modulo-control-de-obra.md) — correlativo POR PROYECTO (a diferencia
  // del folio de Recibos, que es por empresa). Se incrementa con `increment`
  // dentro de la misma transacción de cierre de semana que crea la
  // EstimacionCliente — mismo mecanismo que Empresa.ultimoFolioRecibo.
  ultimoNumeroEstimacion Int @default(0)

  // Correlativos por capa (arquitectura por capas, agosto 2026) — Cliente y
  // Cliente Priv. emiten con folio propio e independiente, asignado solo al
  // emitir esa capa (ver EstimacionClienteCapa.numero). El backfill arranca
  // ambos clonando el valor de ultimoNumeroEstimacion de arriba, así la
  // numeración futura nunca choca con el historial ya emitido.
  ultimoNumeroEstimacionOperativo Int @default(0)
  ultimoNumeroEstimacionPrivado   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiarios          BeneficiarioProyecto[]
  partidas               Partida[]
  cierresSemana          CierreSemanaProyecto[]
  cortesSemana           CorteSemanal[]
  estimacionesCliente    EstimacionCliente[]
  movimientosFinancieros MovimientoFinancieroCliente[]
  gastosObra             GastoObra[]
  reposicionesGastos     ReposicionGastos[]
  ordenesCompra          OrdenCompra[]
  requisiciones          Requisicion[]
  gastosRecurrentes      GastoRecurrente[]
  egresos                Egreso[]
  ingresos               Ingreso[]

  @@index([empresaId])
  @@index([supervisorUsuarioId])
  @@map("proyectos")
}

// Identidad única de a quién se le puede pagar, sin importar en cuántos
// proyectos participe (ver BeneficiarioProyecto para lo específico a cada
// obra). Son conceptos independientes de Usuario aunque puedan corresponder
// a la misma persona real (ej. Charles inicia sesión como Usuario, pero
// cobra sueldo como Beneficiario) — el vínculo entre ambos es opcional y
// nunca implícito, ver el campo `usuario` más abajo.
model Beneficiario {
  id        String           @id @default(cuid())
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  empresaId String
  tipo      TipoBeneficiario
  nombre    String
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  proveedor              Proveedor?
  contratista            Contratista?
  personalAdministrativo PersonalAdministrativo?
  proyectos              BeneficiarioProyecto[]
  gastosPagados          GastoObra[]             @relation("GastoPagador")
  gastosProveedor        GastoObra[]             @relation("GastoProveedor")
  reposicionesGastos     ReposicionGastos[]
  ordenesCompra          OrdenCompra[]
  cotizaciones           Cotizacion[]
  gastosRecurrentes      GastoRecurrente[]

  // Vínculo opcional y explícito con el Usuario que inicia sesión como esta
  // misma persona real (ej. Andrés es Usuario/Supervisor y también
  // Beneficiario/ADMINISTRACION para que se le puedan reponer gastos
  // personales sin registrarlo como Contratista). Uno-a-uno en ambos
  // sentidos vía el @unique — nunca se infiere por nombre/email, solo se
  // establece explícitamente desde el catálogo de Personal/Administración.
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId String?  @unique

  // Vínculo opcional y explícito para resolver duplicados de identidad de
  // pago — una misma persona real puede tener más de una fila Beneficiario
  // (ej. Contratista temporal + Personal/Administración ya existente).
  // Nunca se infiere por nombre (dos personas distintas pueden compartir
  // nombre); se fija a mano desde Catálogos y siempre apunta a la fila raíz
  // canónica, nunca a otro alias (resolverMismaPersonaQueId en
  // lib/server/catalogos.ts valida auto-referencia, misma empresa y
  // ciclos). Filas con este campo lleno son alias y se excluyen de
  // cualquier selector de beneficiarios (ej. "¿Quién pagó?" en Gastos) —
  // el historial (GastoObra.pagadorBeneficiarioId, BeneficiarioProyecto,
  // etc.) nunca se reescribe (beneficiarios duplicados, agosto 2026).
  mismaPersonaQue   Beneficiario?  @relation("BeneficiarioMismaPersona", fields: [mismaPersonaQueId], references: [id])
  mismaPersonaQueId String?
  alias             Beneficiario[] @relation("BeneficiarioMismaPersona")

  @@index([empresaId, tipo])
  @@index([mismaPersonaQueId])
  @@map("beneficiarios")
}

// Datos propios del proveedor — no cambian de una obra a otra.
model Proveedor {
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  beneficiarioId String       @id
  // Nombre comercial ya vive en Beneficiario.nombre — razonSocial es el dato
  // fiscal completo, cuando difiere (Compras, septiembre 2026). Nullable:
  // ningún proveedor histórico lo tiene todavía.
  razonSocial    String?
  giro           String?
  vendedor       String?
  telefono       String?
  credito        String? // solo informativo, no afecta cálculos
  cuentaBancaria String? // solo informativo, no afecta cálculos
  // Dato estructurado (18 dígitos, validado en el servicio al capturar) — a
  // diferencia de cuentaBancaria, que sigue siendo texto libre. Nullable:
  // ningún proveedor histórico lo tiene todavía.
  clabe          String?
  // Dato de identidad fiscal — se guarda desde ya sin ninguna validación de
  // formato ni lógica fiscal asociada; se reutilizará cuando exista el
  // Estado de Cuenta Fiscal (fuera de alcance de esta etapa).
  rfc            String?

  @@map("proveedores")
}

// Dato general del contratista — especialidad/giro (ej. "Obra civil",
// "Herrería"), igual en cualquier obra. Se usa como sugerencia: al elegir un
// contratista existente en el formulario de "Nuevo contrato" de una obra, el
// campo Descripción de ESE contrato se precarga desde aquí, pero sigue
// siendo editable por contrato sin modificar este catálogo (un mismo
// contratista puede tener un alcance distinto en una obra puntual). Al
// capturar un contratista nuevo desde dentro de una obra, la Descripción de
// ese primer contrato siembra este campo (Catálogos: Contratistas, agosto 2026).
model Contratista {
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  beneficiarioId String       @id
  descripcion    String?

  @@map("contratistas")
}

// Datos biográficos/personales — lo laboral (puesto, sueldo) vive en
// BeneficiarioProyecto porque puede variar según la obra asignada.
model PersonalAdministrativo {
  beneficiario    Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  beneficiarioId  String       @id
  nss             String?
  fechaNacimiento DateTime?

  @@map("personal_administrativo")
}

// La participación de un Beneficiario en un Proyecto — aquí vive todo lo que
// depende de la combinación beneficiario+obra (contrato de un contratista,
// puesto/sueldo de alguien de administración). Un mismo beneficiario tiene
// una fila por cada obra en la que participa, cada una con su propio saldo.
model BeneficiarioProyecto {
  id             String       @id @default(cuid())
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])
  beneficiarioId String
  proyecto       Proyecto     @relation(fields: [proyectoId], references: [id])
  proyectoId     String
  activo         Boolean      @default(true)

  // Contratista (aplica cuando beneficiario.tipo = CONTRATISTA)
  concepto      String?
  montoContrato Decimal? @db.Decimal(14, 2)

  // Administración (aplica cuando beneficiario.tipo = ADMINISTRACION)
  puesto         String?
  sueldo         Decimal?  @db.Decimal(14, 2)
  sueldoVariable Boolean?
  fechaIngreso   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aditivas     Aditiva[]
  movimientos  MovimientoSemanal[]
  contratos    ContratoContratista[]
  cortesSemana CorteSemanal[]

  @@unique([beneficiarioId, proyectoId])
  @@index([proyectoId])
  @@map("beneficiario_proyectos")
}

// Trabajo fuera del alcance contratado original. Solo las AUTORIZADAs suman
// al monto contractual vigente (Contrato + Aditivas autorizadas = vigente;
// Saldo = vigente − pagado). Flujo: la solicita un Supervisor, la autoriza
// un Director (01-administracion-pagos-semanales.md).
model Aditiva {
  id                     String               @id @default(cuid())
  beneficiarioProyecto   BeneficiarioProyecto @relation(fields: [beneficiarioProyectoId], references: [id])
  beneficiarioProyectoId String
  monto                  Decimal              @db.Decimal(14, 2)
  descripcion            String
  estatus                EstatusAditiva       @default(PENDIENTE)
  solicitadaPor          Usuario              @relation("AditivasSolicitadas", fields: [solicitadaPorId], references: [id])
  solicitadaPorId        String
  autorizadaPor          Usuario?             @relation("AditivasAutorizadas", fields: [autorizadaPorId], references: [id])
  autorizadaPorId        String?
  fechaSolicitud         DateTime             @default(now())
  fechaAutorizacion      DateTime?

  @@index([beneficiarioProyectoId])
  @@map("aditivas")
}

// Compartida por todas las obras de la empresa — el ciclo semanal de pagos
// es a nivel compañía, no por proyecto.
model Semana {
  id          String        @id @default(cuid())
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  empresaId   String
  numero      Int
  anio        Int
  fechaInicio DateTime
  fechaFin    DateTime
  estado      EstatusSemana @default(ABIERTA)

  movimientos         MovimientoSemanal[]
  avancesConcepto     AvanceConcepto[]
  cierresSemana       CierreSemanaProyecto[]
  cortesSemana        CorteSemanal[]
  estimacionesCliente EstimacionCliente[]
  gastosObra          GastoObra[]
  reposicionesGastos  ReposicionGastos[]
  ordenesCompra       OrdenCompra[]

  @@unique([empresaId, numero, anio])
  @@map("semanas")
}

// El registro central del módulo: cuánto se le debe/pagó a un beneficiario,
// en un proyecto, en una semana. Único por beneficiarioProyecto+semana para
// que "registrar pago" nunca duplique — siempre actualiza el existente.
model MovimientoSemanal {
  id                     String               @id @default(cuid())
  beneficiarioProyecto   BeneficiarioProyecto @relation(fields: [beneficiarioProyectoId], references: [id])
  beneficiarioProyectoId String
  semana                 Semana               @relation(fields: [semanaId], references: [id])
  semanaId               String

  // Opcional (sección 49.9): a qué contrato específico corresponde este pago,
  // cuando el contratista tiene más de uno en la misma obra. null = el
  // movimiento sigue asociado solo a BeneficiarioProyecto, como hoy — no se
  // asume "un contratista = un contrato por proyecto". Prepara el terreno
  // para Pagado acumulado/Saldo/Estado de cuenta por contrato (futuro,
  // todavía no implementado).
  contratoContratista   ContratoContratista? @relation(fields: [contratoContratistaId], references: [id])
  contratoContratistaId String?

  montoEntreSemana Decimal @default(0) @db.Decimal(14, 2)
  montoFinSemana   Decimal @default(0) @db.Decimal(14, 2)

  // De dónde viene este movimiento — un mismo beneficiario puede tener más de
  // uno en la misma semana si las fuentes son distintas (p. ej. un corte de
  // contratista Y una reposición de gastos que él mismo pagó). Antes de que
  // existiera este campo, el único writer de este modelo era Cierre Semanal
  // (CORTE_CONTRATISTA) — la migración que lo agrega respeta eso para las
  // filas existentes. Decisión de sesión, agosto 2026 (Gastos de Obra).
  origen OrigenMovimientoSemanal

  estatusAprobacion EstatusAprobacion @default(PENDIENTE_VALIDACION)
  estatusPago       EstatusPago       @default(SIN_MOVIMIENTO)

  // Bandera para el futuro módulo de Préstamos/Reposiciones — se conserva
  // aunque el movimiento después llegue a LIQUIDADO.
  cubiertoPorFondoPuente Boolean  @default(false)
  fondoPuenteUsuario     Usuario? @relation("FondoPuente", fields: [fondoPuenteUsuarioId], references: [id])
  fondoPuenteUsuarioId   String?

  // Evidencia mínima del pago — se llenan únicamente al liquidar (Reporte
  // General), en la misma transacción que cambia estatusPago a LIQUIDADO.
  // metodoPago reutiliza el mismo enum que Gastos de Obra/Órdenes de Compra
  // (MetodoPagoGasto) — no se duplica un catálogo de método de pago propio.
  fechaPago      DateTime?
  metodoPago     MetodoPagoGasto?
  referenciaPago String?
  notasPago      String?
  liquidadoPor   Usuario?         @relation("MovimientoLiquidado", fields: [liquidadoPorId], references: [id])
  liquidadoPorId String?
  liquidadoEn    DateTime?

  enviadoPor    Usuario  @relation("MovimientosEnviados", fields: [enviadoPorId], references: [id])
  enviadoPorId  String
  aprobadoPor   Usuario? @relation("MovimientosAprobados", fields: [aprobadoPorId], references: [id])
  aprobadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comentarios      ComentarioMovimiento[]
  corte            CorteSemanal?
  reposicionGastos ReposicionGastos?
  ordenCompra      OrdenCompra?

  // Antes: @@unique([beneficiarioProyectoId, semanaId]), luego
  // @@unique([..., origen]) — un movimiento por beneficiario+semana+origen.
  // CORTE_CONTRATISTA/ORDEN_COMPRA/MANUAL siguen exactamente así (a lo más
  // uno). REPOSICION_GASTOS ya no: una vez que ese movimiento queda
  // LIQUIDADO, un gasto aprobado después para el mismo beneficiario+semana
  // abre una reposición complementaria con su propio MovimientoSemanal
  // nuevo — la integridad de "a lo más UNA reposición ABIERTA" ya la da el
  // índice único parcial de ReposicionGastos (`cerrada = false`), no este.
  // No representable como @@unique normal — índice único PARCIAL en la
  // migración (WHERE origen != 'REPOSICION_GASTOS') — mismo patrón que el
  // resto de índices parciales de esta sesión (colapso de doble aprobación
  // Gastos→Reposiciones, agosto 2026).
  @@index([beneficiarioProyectoId, semanaId, origen])
  @@index([semanaId])
  @@map("movimientos_semanales")
}

// Hilo de notas libres, separado del monto (no una celda de Excel).
model ComentarioMovimiento {
  id           String            @id @default(cuid())
  movimiento   MovimientoSemanal @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  movimientoId String
  usuario      Usuario           @relation(fields: [usuarioId], references: [id])
  usuarioId    String
  texto        String
  createdAt    DateTime          @default(now())

  @@index([movimientoId])
  @@map("comentarios_movimiento")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 2: estructura contractual
// Ver /docs/negocio/04-modulo-control-de-obra.md (sección 49 para las
// decisiones de arquitectura de esta capa: BeneficiarioProyecto conserva su
// significado, ContratoContratista es 1:N debajo de él, sin precios
// normal/privado todavía).
// ---------------------------------------------------------------------------

enum ConceptoEstatus {
  ACTIVO
  CANCELADO
}

enum EstatusPartida {
  ACTIVA
  CANCELADA
}

model Partida {
  id         String   @id @default(cuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  nombre     String
  orden      Int      @default(0)

  // Presentación visual — opcional, puramente decorativo. `icono` es una
  // clave de un catálogo curado (no cualquier string libre), validada en el
  // servicio contra lib/control-de-obra/iconos-partida.ts; `color` es un
  // token del mismo catálogo. null = sin icono asignado (comportamiento
  // actual, no afecta nada del modelo contractual).
  icono String?
  color String?

  // Eliminar una Partida — mismo criterio que ConceptoEstatus: si no tiene
  // ningún Concepto con historial real, se borra la fila de verdad; si le
  // queda al menos un Concepto cancelado (con historial), la Partida misma
  // no se puede borrar por FK y queda como CANCELADA (Eliminar Partidas/
  // Conceptos, septiembre 2026).
  estatus EstatusPartida @default(ACTIVA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conceptos Concepto[]

  @@index([proyectoId])
  @@map("partidas")
}

model Concepto {
  id                 String          @id @default(cuid())
  partida            Partida         @relation(fields: [partidaId], references: [id])
  partidaId          String
  codigo             String?
  descripcion        String
  unidad             String
  cantidadContratada Decimal         @db.Decimal(14, 3)
  orden              Int             @default(0)
  notas              String?
  estatus            ConceptoEstatus @default(ACTIVO)

  // Contrato General — presupuesto por componente de costo (sección 49.9).
  // Todo opcional: un concepto puede existir sin costeo todavía. Indirectos y
  // Herramienta solo tienen sentido si Proyecto.esquemaContractual =
  // PRECIO_ALZADO, pero el campo no se oculta a nivel de schema — la validación
  // de qué aplica vive en el servicio, según el esquema del proyecto.
  precioUnitarioContratista Decimal? @db.Decimal(14, 2)
  precioUnitarioMateriales  Decimal? @db.Decimal(14, 2)
  precioUnitarioIndirectos  Decimal? @db.Decimal(14, 2)
  precioUnitarioHerramienta Decimal? @db.Decimal(14, 2)

  // Contrato General Privado — copia EDITABLE del P.U. de arriba, propia de
  // esta capa. Nace igual (null = "todavía no se editó aquí, se ve/usa igual
  // al de Contrato General") pero a partir de que alguien la edita desde
  // Privado es independiente: nunca sobreescribe ni se sincroniza con
  // precioUnitarioContratista, que sigue siendo exclusivo de Contrato General
  // operativo (decisión de sesión, agosto 2026 — Privado dejó de compartir
  // este campo con Contrato General para no afectar el original al editar).
  precioUnitarioContratistaPrivado Decimal? @db.Decimal(14, 2)

  // Mismo patrón que arriba, aplicado a lo estructural — decisión de sesión,
  // agosto 2026: se revirtió la regla anterior ("una sola fuente de verdad,
  // Privado siempre lee el mismo Concepto en vivo") a propósito. Ahora
  // Contrato General Privado edita su PROPIA copia de descripción/unidad/
  // cantidad: nace igual (null = usa la de Contrato General) pero deja de
  // seguir los cambios de Contrato General en cuanto se edita aquí.
  descripcionPrivado        String?
  unidadPrivado             String?
  cantidadContratadaPrivado Decimal? @db.Decimal(14, 3)

  // Override del % default del proyecto — separados (nunca un campo
  // genérico) por la misma razón que en Proyecto. null = usa el default.
  porcentajeUtilidad       Decimal? @db.Decimal(5, 2)
  porcentajeAdministracion Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones           ContratoConcepto[]
  avances                AvanceConcepto[]
  corteDetalles          CorteSemanalConcepto[]
  estimacionDetalles     EstimacionClienteConcepto[]
  estimacionCapaDetalles EstimacionClienteCapaConcepto[]
  requisiciones          Requisicion[]

  @@index([partidaId])
  @@map("conceptos")
}

// Un contrato específico de un contratista dentro de su participación en el
// proyecto (BeneficiarioProyecto). Un mismo BeneficiarioProyecto puede tener
// varios ContratoContratista. Solo aplica a beneficiarios tipo CONTRATISTA
// (validado en el servicio). No guarda monto — se calcula sumando
// ContratoConcepto al vuelo.
model ContratoContratista {
  id                     String               @id @default(cuid())
  beneficiarioProyecto   BeneficiarioProyecto @relation(fields: [beneficiarioProyectoId], references: [id])
  beneficiarioProyectoId String
  numeroContrato         String?
  descripcion            String?
  fecha                  DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  conceptos   ContratoConcepto[]
  movimientos MovimientoSemanal[]

  @@index([beneficiarioProyectoId])
  @@map("contratos_contratista")
}

// Un concepto solo puede pertenecer a UN contratista — nunca se reparte
// (decisión de sesión, agosto 2026, sustituye la posibilidad de repartir un
// concepto entre varios contratistas planteada antes; ver sección 49.9).
// `conceptoId` es único por sí solo (no compuesto) para que la base de datos
// misma impida la doble asignación, no solo la validación del servicio.
// cantidad/precioUnitarioContratista se heredan de Concepto al momento de
// asignar y quedan congelados — no se vuelven a capturar a mano ni se
// resincronizan si el presupuesto del Contrato General cambia después.
model ContratoConcepto {
  id                        String              @id @default(cuid())
  contratoContratista       ContratoContratista @relation(fields: [contratoContratistaId], references: [id])
  contratoContratistaId     String
  concepto                  Concepto            @relation(fields: [conceptoId], references: [id])
  conceptoId                String              @unique
  cantidad                  Decimal             @db.Decimal(14, 3)
  precioUnitarioContratista Decimal             @db.Decimal(14, 2)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  corteDetalles CorteSemanalConcepto[]

  @@index([contratoContratistaId])
  @@map("contrato_conceptos")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 4: avance físico
// Ver /docs/negocio/04-modulo-control-de-obra.md sección 14 y 49.9. El avance
// se registra por Concepto (una sola fuente de verdad para la cantidad
// física), no por ContratoConcepto/contratista — cuando un concepto está
// repartido entre varios contratistas, el avance no se atribuye a ninguno en
// particular (decisión de sesión, agosto 2026). empresaId es explícito por
// decisión de arquitectura, aunque sea alcanzable transitivamente vía
// concepto → partida → proyecto → empresa.
// ---------------------------------------------------------------------------

enum EstatusAprobacionAvance {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model AvanceConcepto {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  concepto   Concepto @relation(fields: [conceptoId], references: [id])
  conceptoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  // Lo capturado ESA semana únicamente — acumulado/pendiente/% siempre se
  // derivan sumando estas filas en lectura, nunca se guardan calculados.
  cantidadEjecutada Decimal @db.Decimal(14, 3)

  // Solo lo APROBADO cuenta en Acumulado/Pendiente/%/indicadores en otras
  // pantallas (Contratistas, resumen). Cualquier guardado (de cualquier rol,
  // incluido quien aprueba) regresa el registro a PENDIENTE — aprobar es
  // siempre una acción explícita separada de capturar/editar la cantidad.
  estatusAprobacion EstatusAprobacionAvance @default(PENDIENTE)
  aprobadoPor       Usuario?                @relation("AvanceAprobado", fields: [aprobadoPorId], references: [id])
  aprobadoPorId     String?
  fechaAprobacion   DateTime?

  registradoPor   Usuario @relation("AvanceRegistrado", fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corteDetalle CorteSemanalConcepto?

  @@unique([conceptoId, semanaId])
  @@index([empresaId])
  @@index([semanaId])
  @@index([estatusAprobacion])
  @@map("avance_conceptos")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 5: cierre semanal
// Ver /docs/negocio/04-modulo-control-de-obra.md. Consolida oficialmente el
// avance aprobado de un proyecto+semana: genera el corte de cada contratista
// y su MovimientoSemanal en Reporte General. Decisión de sesión, agosto 2026.
// ---------------------------------------------------------------------------

// GENERADO = corte vigente (con o sin monto). ANULADO = se reconció a $0 (el
// contratista dejó de tener avance aprobado esa semana tras una reapertura) —
// no se borra, solo deja de contar como activo (mismo criterio que
// MovimientoSemanal.estatusAprobacion = CANCELADO / estatusPago =
// SIN_MOVIMIENTO, que es lo que se le aplica al movimiento enlazado).
enum EstatusCorteSemanal {
  GENERADO
  ANULADO
}

// Candado de cierre por proyecto+semana — independiente de Semana.estado
// (que es compartido por toda la empresa, no por proyecto: cada obra aprueba
// y cierra a su propio ritmo). Reutiliza EstatusSemana (ABIERTA/CERRADA) por
// tener el mismo significado, solo que aquí scoped a un proyecto. El
// historial completo de aperturas/cierres vive en RegistroAuditoria — esta
// fila solo refleja el estado actual (mismo patrón que Proyecto.estatus).
model CierreSemanaProyecto {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  estatus EstatusSemana @default(CERRADA)

  cerradoPor   Usuario  @relation("CierreSemanaGenerado", fields: [cerradoPorId], references: [id])
  cerradoPorId String
  cerradoEn    DateTime @default(now())

  reabiertoPor     Usuario?  @relation("CierreSemanaReabierto", fields: [reabiertoPorId], references: [id])
  reabiertoPorId   String?
  reabiertoEn      DateTime?
  motivoReapertura String?

  cortes CorteSemanal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proyectoId, semanaId])
  @@index([empresaId])
  @@map("cierres_semana_proyecto")
}

// Corte semanal de UN contratista en UN proyecto — agrupa por
// beneficiarioProyectoId (no por ContratoContratista individual), consistente
// con que MovimientoSemanal ya es único por beneficiarioProyectoId+semanaId:
// "un solo corte por obra por semana" aunque el contratista tenga varios
// contratos, conceptos o partidas. Se genera la primera vez que hay avance
// aprobado; en un recierre posterior se reconcilia en el lugar (nunca se
// duplica) mientras su MovimientoSemanal no esté LIQUIDADO.
model CorteSemanal {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  cierreSemanaProyecto   CierreSemanaProyecto @relation(fields: [cierreSemanaProyectoId], references: [id])
  cierreSemanaProyectoId String

  beneficiarioProyecto   BeneficiarioProyecto @relation(fields: [beneficiarioProyectoId], references: [id])
  beneficiarioProyectoId String

  // Correlativo simple por proyecto, solo para mostrarlo en pantalla — NO es
  // el futuro folio de Recibo (ese será único a nivel compañía, sección
  // "Recibo de Pago" de 02-control-de-obra.md, todavía no implementado).
  numero Int

  montoBruto Decimal @db.Decimal(14, 2)
  ajustes    Decimal @default(0) @db.Decimal(14, 2)
  montoNeto  Decimal @db.Decimal(14, 2)

  estatus EstatusCorteSemanal @default(GENERADO)

  movimientoSemanal   MovimientoSemanal? @relation(fields: [movimientoSemanalId], references: [id])
  movimientoSemanalId String?            @unique

  generadoPor   Usuario @relation("CorteSemanalGenerado", fields: [generadoPorId], references: [id])
  generadoPorId String

  detalle CorteSemanalConcepto[]
  recibos ReciboPago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proyectoId, semanaId, beneficiarioProyectoId])
  @@index([empresaId])
  @@map("cortes_semanales")
}

// Detalle congelado del corte — una copia, no una referencia recalculable.
// El P.U. viene de ContratoConcepto.precioUnitarioContratista (ya congelado
// al asignar el contratista), nunca de Concepto en vivo. Nunca se recalcula
// leyendo el estado actual: si el Contrato General cambia después, esta fila
// no se entera (regla explícita — el precio queda fijo históricamente).
model CorteSemanalConcepto {
  id             String       @id @default(cuid())
  corteSemanal   CorteSemanal @relation(fields: [corteSemanalId], references: [id])
  corteSemanalId String

  concepto   Concepto @relation(fields: [conceptoId], references: [id])
  conceptoId String

  contratoConcepto   ContratoConcepto @relation(fields: [contratoConceptoId], references: [id])
  contratoConceptoId String

  avanceConcepto   AvanceConcepto @relation(fields: [avanceConceptoId], references: [id])
  avanceConceptoId String         @unique

  descripcionConcepto       String
  unidad                    String
  cantidadEjecutada         Decimal @db.Decimal(14, 3)
  precioUnitarioContratista Decimal @db.Decimal(14, 2)
  importe                   Decimal @db.Decimal(14, 2)

  @@index([corteSemanalId])
  @@map("corte_semanal_conceptos")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 6: recibos de pago
// Ver /docs/negocio/02-control-de-obra.md, sección "Recibo de Pago". Decisión
// de sesión, agosto 2026.
// ---------------------------------------------------------------------------

// VIGENTE = el recibo actual de ese corte. SUPERSEDIDO = reemplazado por una
// regeneración (o invalidado por una reconciliación) — se conserva siempre,
// nunca se borra. Un corte puede acumular varios ReciboPago a lo largo del
// tiempo, pero como mucho uno VIGENTE — se hace cumplir en el servicio
// (dentro de una transacción), no con un índice único parcial.
enum EstatusReciboPago {
  VIGENTE
  SUPERSEDIDO
}

model ReciboPago {
  id             String       @id @default(cuid())
  empresa        Empresa      @relation(fields: [empresaId], references: [id])
  empresaId      String
  corteSemanal   CorteSemanal @relation(fields: [corteSemanalId], references: [id])
  corteSemanalId String

  // Folio único por empresa (no por proyecto — sección "Recibo de Pago" de
  // 02-control-de-obra.md). Se guarda ya formateado ("REC-000001") para que
  // un cambio futuro de formato nunca reescriba folios ya emitidos.
  numeroFolio Int
  folio       String

  estatus EstatusReciboPago @default(VIGENTE)

  // Snapshot de la configuración de recibo de Empresa AL MOMENTO de generar
  // — el documento histórico se ve igual aunque la configuración cambie
  // después (título, leyenda, razón social, qué mostrar).
  configuracionSnapshot Json

  generadoPor   Usuario  @relation("ReciboPagoGenerado", fields: [generadoPorId], references: [id])
  generadoPorId String
  createdAt     DateTime @default(now())

  // Evidencia firmada — null hasta que se sube. El estado de pago NO se
  // duplica aquí: se lee siempre en vivo vía corteSemanal.movimientoSemanal.
  archivoEvidenciaRef    String?
  archivoEvidenciaNombre String?
  fechaRecepcion         DateTime?
  subidoPor              Usuario?  @relation("ReciboPagoEvidenciaSubida", fields: [subidoPorId], references: [id])
  subidoPorId            String?
  subidoEn               DateTime?

  @@unique([empresaId, folio])
  @@index([corteSemanalId])
  @@map("recibos_pago")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 7: Cliente / Cliente Priv.
// Ver /docs/negocio/04-modulo-control-de-obra.md. Valoriza el mismo avance
// físico de AvanceConcepto hacia el cliente — Cliente usa la lógica de
// Contrato General (operativo), Cliente Priv. la de Contrato General Privado.
// Un solo avance físico, dos valorizaciones — nunca dos fuentes de verdad de
// cantidad. Mientras la semana está ABIERTA no existe fila aquí (la vista
// calcula en vivo); al CERRAR la semana se genera/reconcilia en BORRADOR
// dentro de la misma transacción de cierre; EMITIDA queda congelada para
// siempre, ni una reapertura ni un recierre posterior la tocan. Decisión de
// sesión, agosto 2026.
// ---------------------------------------------------------------------------

enum EstatusEstimacionCliente {
  BORRADOR
  EMITIDA
}

// Cliente (operativo, sin sufijo históricamente) y Cliente Priv. — a partir de
// la arquitectura por capas (agosto 2026) cada una emite, cobra y factura de
// forma independiente. Ver EstimacionClienteCapa.
enum CapaEstimacion {
  OPERATIVO
  PRIVADO
}

model EstimacionCliente {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  // DEPRECATED (arquitectura por capas, agosto 2026) — el folio real ahora
  // vive en EstimacionClienteCapa.numero, uno independiente por capa. Se
  // conserva nullable únicamente para no perder el folio de las filas
  // históricas ya emitidas antes del rediseño; ninguna fila nueva lo llena.
  numero Int?

  // DEPRECATED (arquitectura por capas, agosto 2026) — el estatus real de
  // cada capa vive en EstimacionClienteCapa.estatus. Este campo ya no se
  // actualiza para filas nuevas (se queda en su default BORRADOR sin
  // significado); se conserva solo por compatibilidad histórica de lectura.
  estatus EstatusEstimacionCliente @default(BORRADOR)

  // Snapshot del esquema al momento de generar — si el esquema del proyecto
  // cambiara después, esta fila no cambia de significado retroactivamente.
  esquemaContractualUsado EsquemaContractual?

  // DEPRECATED en bloque (arquitectura por capas, agosto 2026) — todo el
  // dinero de una estimación ahora vive en EstimacionClienteCapa, una fila
  // por capa, congelado solo al emitir esa capa. Estos campos se vuelven
  // nullable/sin escritura para filas nuevas y se conservan intactos en las
  // filas históricas únicamente hasta que el backfill quede verificado.
  subtotal                     Decimal? @db.Decimal(14, 2)
  montoAdministracionOUtilidad Decimal? @db.Decimal(14, 2)
  total                        Decimal? @db.Decimal(14, 2)

  subtotalOperativo                    Decimal @default(0) @db.Decimal(14, 2)
  montoAdministracionTrabajosOperativo Decimal @default(0) @db.Decimal(14, 2)
  totalOperativo                       Decimal @default(0) @db.Decimal(14, 2)

  subtotalGastosCobrables                 Decimal  @default(0) @db.Decimal(14, 2)
  porcentajeAdministracionGastosOperativo Decimal? @db.Decimal(5, 2)
  montoAdministracionGastosOperativo      Decimal  @default(0) @db.Decimal(14, 2)
  porcentajeAdministracionGastosPrivado   Decimal? @db.Decimal(5, 2)
  montoAdministracionGastosPrivado        Decimal  @default(0) @db.Decimal(14, 2)

  aplicaIVA         Boolean  @default(false)
  porcentajeIVA     Decimal? @db.Decimal(5, 2)
  montoIVA          Decimal  @default(0) @db.Decimal(14, 2)
  montoIVAOperativo Decimal  @default(0) @db.Decimal(14, 2)

  generadoPor   Usuario  @relation("EstimacionClienteGenerada", fields: [generadoPorId], references: [id])
  generadoPorId String
  generadoEn    DateTime @default(now())

  emitidoPor   Usuario?  @relation("EstimacionClienteEmitida", fields: [emitidoPorId], references: [id])
  emitidoPorId String?
  emitidoEn    DateTime?

  // Corte del documento histórico (PDF) — se fija una sola vez, en la
  // primera descarga (cualquier capa), y nunca se vuelve a tocar. Necesario
  // porque MovimientoFinancieroCliente no tiene ningún filtro temporal por
  // sí solo, y porque Concepto/Partida no están versionados (montoContrato
  // se recalcularía distinto si el contrato cambia después de esta
  // estimación) — sin este congelamiento, descargar el mismo documento más
  // adelante podría dar cifras distintas (historial documental, agosto 2026).
  fechaCorteDocumento             DateTime?
  montoContratoOperativoCongelado Decimal?  @db.Decimal(14, 2)
  montoContratoPrivadoCongelado   Decimal?  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalle                EstimacionClienteConcepto[]
  gastos                 EstimacionClienteGasto[]
  gastosCobrados         GastoObra[]                   @relation("GastoIncluidoEnEstimacion")
  movimientosFinancieros MovimientoFinancieroCliente[]

  // Arquitectura por capas (agosto 2026) — el documento financiero real:
  // exactamente 2 filas (OPERATIVO/PRIVADO), cada una con su propio ciclo de
  // vida BORRADOR→EMITIDA, folio, IVA, gastos y pagos. Ver
  // EstimacionClienteCapa.
  capas EstimacionClienteCapa[]

  @@unique([proyectoId, semanaId])
  @@index([empresaId])
  @@map("estimaciones_cliente")
}

model EstimacionClienteConcepto {
  id                  String            @id @default(cuid())
  estimacionCliente   EstimacionCliente @relation(fields: [estimacionClienteId], references: [id])
  estimacionClienteId String
  concepto            Concepto          @relation(fields: [conceptoId], references: [id])
  conceptoId          String

  // Frozen, organizativo — mismo patrón que CorteSemanalConcepto (nunca se
  // vuelve a leer Partida/Concepto en vivo para reconstruir un histórico).
  partidaNombre       String
  descripcionConcepto String
  unidad              String

  cantidadContratada Decimal @db.Decimal(14, 3)
  cantidadAnterior   Decimal @db.Decimal(14, 3)
  cantidadEstaSemana Decimal @db.Decimal(14, 3)
  cantidadAcumulada  Decimal @db.Decimal(14, 3)
  cantidadPorEjercer Decimal @db.Decimal(14, 3)
  avancePorcentaje   Decimal @db.Decimal(5, 2)

  // DEPRECATED (arquitectura por capas, agosto 2026) — el precio ya no vive
  // aquí: esta fila es puramente física/compartida (cantidades), y cada capa
  // congela su propio precio en EstimacionClienteCapaConcepto solo al
  // emitir. Nullable para no exigir dummy values en filas nuevas; se
  // conservan intactos en las filas históricas hasta verificar el backfill.
  precioUnitarioOperativo    Decimal? @db.Decimal(14, 2)
  importeContratadoOperativo Decimal? @db.Decimal(14, 2)
  importeEstaSemanaOperativo Decimal? @db.Decimal(14, 2)
  importeAcumuladoOperativo  Decimal? @db.Decimal(14, 2)
  importePorEjercerOperativo Decimal? @db.Decimal(14, 2)

  precioUnitarioPrivado     Decimal? @db.Decimal(14, 2)
  importeContratadoPrivado  Decimal? @db.Decimal(14, 2)
  importeEstaSemanaPrivado  Decimal? @db.Decimal(14, 2)
  importeAcumuladoPrivado   Decimal? @db.Decimal(14, 2)
  importePorEjercerPrivado  Decimal? @db.Decimal(14, 2)
  porcentajeAplicadoPrivado Decimal? @db.Decimal(5, 2)

  @@index([estimacionClienteId])
  @@index([conceptoId])
  @@map("estimacion_cliente_conceptos")
}

// El documento financiero real — una fila por capa (OPERATIVO/PRIVADO),
// cada una con su propio ciclo de vida BORRADOR→EMITIDA independiente del de
// la otra. Mientras estatus = BORRADOR, subtotal/montoAdministracion*/
// montoIVA/total se quedan en su default (0) y NUNCA se leen para mostrar la
// pantalla — la pantalla BORRADOR se calcula en vivo con
// calcularEstimacionCapaEnVivo (lib/server/control-de-obra/
// estimacion-cliente.ts). Esas columnas, junto con `numero` y el detalle
// (EstimacionClienteCapaConcepto/EstimacionClienteGasto), se escriben una
// sola vez, dentro de la transacción de emitirEstimacion. Arquitectura por
// capas — Cliente/Cliente Priv. como documentos financieros independientes,
// agosto 2026.
model EstimacionClienteCapa {
  id                  String            @id @default(cuid())
  estimacionCliente   EstimacionCliente @relation(fields: [estimacionClienteId], references: [id])
  estimacionClienteId String
  capa                CapaEstimacion

  estatus EstatusEstimacionCliente @default(BORRADOR)

  // Configuración editable mientras BORRADOR — se persiste de inmediato al
  // configurarla (es una decisión del usuario, no un cálculo derivado; no
  // hay otra fuente de verdad para "esta capa activó IVA a 16%").
  aplicaIVA     Boolean  @default(false)
  porcentajeIVA Decimal? @db.Decimal(5, 2)

  // --- Snapshot congelado — solo tiene significado real si estatus = EMITIDA ---
  // Correlativo propio de esta capa (Proyecto.ultimoNumeroEstimacionOperativo/
  // ...Privado) — asignado SOLO al emitir, nunca al crear la fila BORRADOR
  // (una capa que nunca llega a emitirse no debe "gastar" un folio).
  numero                         Int?
  subtotal                       Decimal  @default(0) @db.Decimal(14, 2)
  montoAdministracionTrabajos    Decimal  @default(0) @db.Decimal(14, 2)
  subtotalGastosCobrables        Decimal  @default(0) @db.Decimal(14, 2)
  porcentajeAdministracionGastos Decimal? @db.Decimal(5, 2)
  montoAdministracionGastos      Decimal  @default(0) @db.Decimal(14, 2)
  montoIVA                       Decimal  @default(0) @db.Decimal(14, 2)
  total                          Decimal  @default(0) @db.Decimal(14, 2)

  generadoPor   Usuario   @relation("EstimacionClienteCapaGenerada", fields: [generadoPorId], references: [id])
  generadoPorId String
  generadoEn    DateTime  @default(now())
  emitidoPor    Usuario?  @relation("EstimacionClienteCapaEmitida", fields: [emitidoPorId], references: [id])
  emitidoPorId  String?
  emitidoEn     DateTime?

  // Corte del documento histórico (PDF) de ESTA capa — mismo criterio que
  // tenía el padre antes del rediseño, ahora independiente por capa.
  fechaCorteDocumento    DateTime?
  montoContratoCongelado Decimal?  @db.Decimal(14, 2)

  // Identidad de Empresa (nombre/razón social/logo) AL MOMENTO de emitir —
  // mismo principio que ReciboPago.configuracionSnapshot: el documento
  // histórico se ve igual aunque la Empresa cambie de branding después.
  // Shape: BrandingEmpresa (lib/server/branding.ts). Null mientras BORRADOR.
  brandingSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalle                  EstimacionClienteCapaConcepto[]
  gastos                   EstimacionClienteGasto[]
  movimientosFinancieros   MovimientoFinancieroCliente[]
  gastosIncluidosOperativo GastoObra[]                     @relation("GastoIncluidoEnCapaOperativo")
  gastosIncluidosPrivado   GastoObra[]                     @relation("GastoIncluidoEnCapaPrivado")

  @@unique([estimacionClienteId, capa])
  @@index([estatus])
  @@map("estimacion_cliente_capas")
}

// El snapshot monetario real por concepto — nace VACÍO mientras la capa es
// BORRADOR (no existen filas todavía) y se materializa de una sola vez,
// dentro de la misma transacción de emitirEstimacion, con los precios
// vigentes EN ESE MOMENTO. Aquí es donde General (emitida con P.U. $500) y
// Privado (emitida después con P.U. $650) quedan completamente
// desacopladas, aunque ambas describan el mismo conceptoId.
model EstimacionClienteCapaConcepto {
  id                      String                @id @default(cuid())
  estimacionClienteCapa   EstimacionClienteCapa @relation(fields: [estimacionClienteCapaId], references: [id])
  estimacionClienteCapaId String
  concepto                Concepto              @relation(fields: [conceptoId], references: [id])
  conceptoId              String

  precioUnitarioBase Decimal  @db.Decimal(14, 2) // antes de administración/utilidad
  porcentajeAplicado Decimal? @db.Decimal(5, 2) // % realmente usado (override o default), congelado
  precioUnitario     Decimal  @db.Decimal(14, 2) // con administración/utilidad ya incluida
  importeContratado  Decimal  @db.Decimal(14, 2)
  importeEstaSemana  Decimal  @db.Decimal(14, 2)
  importeAcumulado   Decimal  @db.Decimal(14, 2)
  importePorEjercer  Decimal  @db.Decimal(14, 2)

  @@unique([estimacionClienteCapaId, conceptoId])
  @@map("estimacion_cliente_capa_conceptos")
}

// Gasto cobrable congelado dentro de la estimación de UNA capa — mismo
// patrón que EstimacionClienteCapaConcepto (copia propia, nunca un join en
// vivo a GastoObra, materializado solo al emitir esa capa — arquitectura por
// capas, agosto 2026), aunque en la práctica un GastoObra ya es inmutable en
// cuanto sale de BORRADOR/PENDIENTE_REVISION (ver editarGasto). El monto
// congelado es el mismo costo real para cualquier capa que lo cobre (un
// gasto no tiene "precio privado" propio), pero puede quedar reclamado y
// congelado en AMBAS capas de forma independiente — por eso ya no es
// @unique por sí solo: @@unique([estimacionClienteCapaId, gastoObraId]),
// GastoObra.incluidoEnCapaOperativoId/incluidoEnCapaPrivadoId son la guardia
// real contra reclamarlo dos veces DENTRO de la misma capa.
model EstimacionClienteGasto {
  id                  String            @id @default(cuid())
  estimacionCliente   EstimacionCliente @relation(fields: [estimacionClienteId], references: [id])
  estimacionClienteId String

  // Nullable únicamente durante la ventana de la migración aditiva — toda
  // fila creada por código nuevo (backfill o emisión por capa) siempre la
  // llena.
  estimacionClienteCapa   EstimacionClienteCapa? @relation(fields: [estimacionClienteCapaId], references: [id])
  estimacionClienteCapaId String?

  gastoObra   GastoObra @relation(fields: [gastoObraId], references: [id])
  gastoObraId String

  fecha       DateTime
  descripcion String
  categoria   String
  monto       Decimal  @db.Decimal(14, 2)

  detalle EstimacionClienteGastoDetalle[]

  @@unique([estimacionClienteCapaId, gastoObraId])
  @@index([estimacionClienteId])
  @@index([gastoObraId])
  @@map("estimacion_cliente_gastos")
}

model EstimacionClienteGastoDetalle {
  id                       String                 @id @default(cuid())
  estimacionClienteGasto   EstimacionClienteGasto @relation(fields: [estimacionClienteGastoId], references: [id])
  estimacionClienteGastoId String

  descripcion    String
  unidad         String
  cantidad       Decimal @db.Decimal(14, 3)
  precioUnitario Decimal @db.Decimal(14, 2)
  // Orden de captura original (mismo patrón que GastoObraDetalle.orden) —
  // congelado al emitir, para que la tabla plana de gastos cobrables y el
  // PDF muestren siempre el mismo orden en que se capturó, sin depender del
  // orden de retorno de la base de datos (presentación plana de gastos
  // cobrables, agosto 2026).
  orden          Int     @default(0)

  @@index([estimacionClienteGastoId])
  @@map("estimacion_cliente_gastos_detalle")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 8: Control Contractual / esquema financiero
// del cliente. Ledger único para las tres cosas que mueven dinero del lado
// del cliente — aportación al fondo, pago de una estimación, y aplicación de
// una estimación contra el fondo — en vez de tres tablas casi idénticas. El
// monto siempre es la magnitud real y positiva; el signo/dirección lo decide
// `tipo`, nunca un negativo en la fila (legible para auditoría). Decisión de
// sesión, agosto 2026.
// ---------------------------------------------------------------------------

// Toda obra se cobra por Estimación; el fondo es una fuente de recursos
// opcional (existe si el proyecto tiene al menos una APORTACION_FONDO) que
// puede cubrir total o parcialmente cualquier estimación emitida — nunca un
// esquema alternativo excluyente (decisión de sesión, agosto 2026 — rediseño
// del modelo financiero del cliente).
enum TipoMovimientoFinancieroCliente {
  APORTACION_FONDO // entrada — no ligada a una estimación específica
  PAGO_ESTIMACION // entrada — pago directo, ligado a una estimación
  APLICACION_ESTIMACION // salida — fondo aplicado contra una estimación, al emitir (si se elige) o manualmente después ("Aplicar fondo")
}

model MovimientoFinancieroCliente {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String

  tipo       TipoMovimientoFinancieroCliente
  monto      Decimal                         @db.Decimal(14, 2)
  fecha      DateTime
  referencia String?
  notas      String?

  // Nunca se borra un cobro/aportación real — se cancela (mismo criterio que
  // Egreso/Ingreso/Factura/ReposicionGastos). TODO cálculo financiero
  // (saldo de estimación, fondo disponible, Contabilidad, Dashboard) debe
  // ignorar los movimientos CANCELADOS (Cobros de cliente, septiembre 2026).
  estatus           EstatusRegistroContable @default(VIGENTE)
  motivoCancelacion String?
  canceladoPor      Usuario?                @relation("MovimientoFinancieroClienteCancelado", fields: [canceladoPorId], references: [id])
  canceladoPorId    String?
  canceladoEn       DateTime?

  // Obligatorio en PAGO_ESTIMACION y APLICACION_ESTIMACION — una estimación
  // puede tener varios de cada uno (pagos parciales, y ahora también varias
  // aplicaciones de fondo en fechas distintas — una al emitir si se elige, y
  // una por cada "Aplicar fondo" manual posterior; el índice único parcial
  // que antes limitaba a una sola aplicación por estimación se retiró en el
  // rediseño del modelo financiero, agosto 2026 — la integridad la da el
  // bloqueo de fila sobre Proyecto al calcular fondo disponible, no un
  // índice). null en APORTACION_FONDO (una aportación es del proyecto, no de
  // una estimación específica).
  // DEPRECATED (arquitectura por capas, agosto 2026) — reemplazada por
  // estimacionClienteCapaId de abajo, que ya deja implícita la capa; código
  // nuevo ya no la escribe en PAGO_ESTIMACION/APLICACION_ESTIMACION.
  estimacionCliente   EstimacionCliente? @relation(fields: [estimacionClienteId], references: [id])
  estimacionClienteId String?

  // Obligatorio en PAGO_ESTIMACION/APLICACION_ESTIMACION para código nuevo —
  // la capa queda implícita por la fila a la que apunta. El fondo mismo
  // (APORTACION_FONDO) sigue sin capa: es efectivo real del proyecto, no de
  // una capa (ver "Fondo disponible del proyecto" en
  // lib/server/control-de-obra/financiero-cliente.ts).
  estimacionClienteCapa   EstimacionClienteCapa? @relation(fields: [estimacionClienteCapaId], references: [id])
  estimacionClienteCapaId String?

  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  registradoPorId String
  createdAt       DateTime @default(now())

  // Decoración fiscal opcional (Contabilidad, septiembre 2026) — mismo
  // criterio que GastoObra.egreso: null hasta que alguien agregue datos
  // fiscales a este pago de cliente.
  ingreso Ingreso?

  @@index([proyectoId])
  @@index([estimacionClienteId])
  @@index([estimacionClienteCapaId])
  @@map("movimientos_financieros_cliente")
}

// ---------------------------------------------------------------------------
// Módulo Control de Obra — Etapa 9: Gastos de Obra (Reposiciones + Órdenes de
// Compra). Ver /docs/negocio/04-modulo-control-de-obra.md. Digitaliza el
// archivo manual de "Reposición de gastos" — captura individual de gasto,
// revisión, agrupación por beneficiario+proyecto+semana, y su reflejo
// automático en Reporte General vía MovimientoSemanal (origen
// REPOSICION_GASTOS / ORDEN_COMPRA). Decisión de sesión, agosto 2026.
// ---------------------------------------------------------------------------

enum EstatusGasto {
  BORRADOR
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
  CANCELADO
}

enum MetodoPagoGasto {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
}

// Si el gasto/OC se cobra al cliente y cómo — independiente de si ya está
// aprobado internamente. NO_COBRABLE por default: no se asume que todo gasto
// aprobado se cobra al cliente (precisión explícita de negocio).
enum TratamientoClienteGasto {
  INCLUIDO_EN_CONTRATO
  COBRABLE_EN_ESTIMACION
  NO_COBRABLE
}

model GastoObra {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  fecha       DateTime // fecha real del ticket, puede no ser la fecha de captura
  descripcion String
  // Catálogo curado en código (lib/control-de-obra/categorias-gasto.ts), no
  // enum de Postgres — puede crecer sin migración (mismo patrón que
  // Partida.icono).
  categoria   String
  monto       Decimal         @db.Decimal(14, 2)
  metodoPago  MetodoPagoGasto

  // Quién puso el dinero — null = lo pagó la empresa directamente (no genera
  // reposición para nadie). No-null = beneficiario personal a reponerle (es
  // el mismo campo para "quién pagó" y "a quién reponer": son la misma
  // persona por definición).
  pagador               Beneficiario? @relation("GastoPagador", fields: [pagadorBeneficiarioId], references: [id])
  pagadorBeneficiarioId String?

  // A quién se le pagó — opcional, Beneficiario tipo PROVEEDOR existente.
  proveedor               Beneficiario? @relation("GastoProveedor", fields: [proveedorBeneficiarioId], references: [id])
  proveedorBeneficiarioId String?

  comentario String?

  requiereFactura Boolean @default(false)
  facturaRef      String?
  facturaNombre   String?
  // estatusFiscal (NO_APLICA/PENDIENTE_FACTURA/FACTURADO) se DERIVA de
  // requiereFactura + facturaRef en el servicio — no es columna.

  tratamientoCliente            TratamientoClienteGasto @default(NO_COBRABLE)
  // DEPRECATED (arquitectura por capas, agosto 2026) — reemplazada por las
  // dos FK de abajo, una guardia independiente por capa. Se conserva
  // nullable únicamente por compatibilidad histórica de lectura; código
  // nuevo ya no la escribe.
  incluidoEnEstimacionCliente   EstimacionCliente?      @relation("GastoIncluidoEnEstimacion", fields: [incluidoEnEstimacionClienteId], references: [id])
  incluidoEnEstimacionClienteId String?

  // Guardia real por capa contra cobrar el mismo gasto dos veces DENTRO de
  // esa capa — en cuanto se llena, ninguna reconciliación posterior de esa
  // capa lo vuelve a considerar elegible. Un gasto puede quedar reclamado en
  // ambas a la vez (General y Privado cobrando el mismo costo real, cada uno
  // en su propio documento). Se escribe únicamente al aprobar el gasto (o al
  // resolver un reclamo pendiente durante una acción real de negocio
  // posterior) — nunca como efecto de una simple lectura de pantalla
  // (arquitectura por capas, agosto 2026).
  incluidoEnCapaOperativo   EstimacionClienteCapa? @relation("GastoIncluidoEnCapaOperativo", fields: [incluidoEnCapaOperativoId], references: [id])
  incluidoEnCapaOperativoId String?
  incluidoEnCapaPrivado     EstimacionClienteCapa? @relation("GastoIncluidoEnCapaPrivado", fields: [incluidoEnCapaPrivadoId], references: [id])
  incluidoEnCapaPrivadoId   String?

  // Detalle multilínea opcional — GastoObra.monto sigue siendo la única
  // fuente de verdad que lee el resto del sistema (reposiciones, dashboard,
  // estimación); cuando hay detalle, monto se recalcula server-side como la
  // suma de las líneas (captura multilínea de gastos, agosto 2026).
  detalle GastoObraDetalle[]

  // Snapshot(s) congelado(s) de este gasto — a lo más uno por capa que lo
  // haya cobrado (arquitectura por capas, agosto 2026; antes era 1:1 vía
  // gastoObraId @unique). Ver EstimacionClienteGasto.
  estimacionesClienteGasto EstimacionClienteGasto[]

  ticketRef    String?
  ticketNombre String?

  // Trazabilidad de una OC ejecutada — null en el 100% de los gastos
  // capturados a mano. Ver OrdenCompra.gastosGenerados.
  ordenCompra   OrdenCompra? @relation(fields: [ordenCompraId], references: [id])
  ordenCompraId String?

  estatus EstatusGasto @default(PENDIENTE_REVISION)

  capturadoPor   Usuario @relation("GastoCapturado", fields: [capturadoPorId], references: [id])
  capturadoPorId String

  revisadoPor   Usuario?  @relation("GastoRevisado", fields: [revisadoPorId], references: [id])
  revisadoPorId String?
  revisadoEn    DateTime?
  motivoRechazo String?

  // "Incluido en reposición" se DERIVA (estatus=APROBADO &&
  // reposicionGastosId != null) — no hay un estado INCLUIDO_EN_REPOSICION
  // aparte, evita que ese estado se desincronice de la relación real.
  reposicion         ReposicionGastos? @relation(fields: [reposicionGastosId], references: [id])
  reposicionGastosId String?

  // Origen recurrente — null si se capturó a mano (el caso normal de hoy).
  // Cada ocurrencia generada es su propia fila GastoObra, independiente para
  // siempre: editar/desactivar el GastoRecurrente nunca reescribe esta fila
  // (Gastos transversal — recurrentes, septiembre 2026).
  recurrente   GastoRecurrente? @relation(fields: [recurrenteId], references: [id])
  recurrenteId String?

  // Decoración fiscal opcional (Contabilidad, septiembre 2026) — null hasta
  // que alguien agregue medio financiero/factura/notas contables a este
  // gasto. Nunca se crea automáticamente al aprobar el gasto.
  egreso Egreso?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proyectoId, semanaId])
  @@index([pagadorBeneficiarioId])
  @@index([reposicionGastosId])
  @@index([incluidoEnEstimacionClienteId])
  @@index([incluidoEnCapaOperativoId])
  @@index([incluidoEnCapaPrivadoId])
  // A lo más UNA ocurrencia generada por GastoRecurrente+Semana — la garantía
  // real de idempotencia de asegurarGastosRecurrentesGenerados, no solo un
  // chequeo en el servicio. Filas con recurrenteId = NULL (la inmensa
  // mayoría, todo gasto capturado a mano) nunca chocan entre sí: Postgres
  // trata NULL como distinto de NULL en un índice único (Gastos transversal
  // — recurrentes, septiembre 2026).
  @@unique([recurrenteId, semanaId])
  @@map("gastos_obra")
}

// Detalle multilínea opcional de un gasto — mismo patrón que
// OrdenCompraConcepto (importe siempre derivado en el servicio, nunca
// columna). Captura multilínea de gastos, agosto 2026.
model GastoObraDetalle {
  id             String    @id @default(cuid())
  gastoObra      GastoObra @relation(fields: [gastoObraId], references: [id])
  gastoObraId    String
  descripcion    String
  unidad         String
  cantidad       Decimal   @db.Decimal(14, 3)
  precioUnitario Decimal   @db.Decimal(14, 2)
  orden          Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([gastoObraId])
  @@map("gastos_obra_detalle")
}

enum EstatusReposicion {
  BORRADOR
  ENVIADA_REVISION
  APROBADA
  RECHAZADA
}

// Agrupación de gastos APROBADOs de un mismo beneficiario/pagador, en un
// proyecto y semana. El pago real se lee siempre de movimientoSemanal — no
// hay un estado de pago propio aquí (evita una segunda fuente de verdad).
model ReposicionGastos {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  folio       String // REP-000123, único por empresa
  numeroFolio Int

  // El pagador al que se le repone — mismo Beneficiario que
  // GastoObra.pagadorBeneficiarioId de cada gasto incluido.
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])
  beneficiarioId String

  estatus EstatusReposicion @default(BORRADOR)
  // Total NO se persiste como campo editable — se deriva sumando
  // gastos.monto en cada lectura.

  creadoPor   Usuario @relation("ReposicionCreada", fields: [creadoPorId], references: [id])
  creadoPorId String

  revisadoPor   Usuario?  @relation("ReposicionRevisada", fields: [revisadoPorId], references: [id])
  revisadoPorId String?
  revisadoEn    DateTime?
  motivoRechazo String?

  // 1:1 — se crea SOLO al aprobar, nunca dos veces (el índice único de esta
  // FK es la garantía real de idempotencia, no solo un chequeo en código).
  movimientoSemanal   MovimientoSemanal? @relation(fields: [movimientoSemanalId], references: [id])
  movimientoSemanalId String?            @unique

  gastos GastoObra[]

  // Una reposición deja de aceptar nuevos gastos/reconciliación en cuanto su
  // MovimientoSemanal queda LIQUIDADO — liquidarMovimiento() la marca aquí,
  // en la misma transacción, justo al liquidar (lib/server/reporte-general/
  // liquidar.ts). asignarGastoAReposicionTx también la marca de forma
  // defensiva si la encuentra desincronizada. Una vez cerrada, un gasto
  // aprobado después para el mismo proyecto+semana+beneficiario abre una
  // reposición complementaria nueva, con folio propio — nunca se reabre ni
  // se reescribe historia financiera ya liquidada (colapso de doble
  // aprobación Gastos→Reposiciones, agosto 2026).
  cerrada Boolean @default(false)

  // Trazabilidad de reposiciones parciales — ver AbonoReposicion. "Saldo
  // pendiente" (total gastos − Σ abonos.monto) es siempre derivado en el
  // servicio, nunca una columna aquí (reposiciones parciales, septiembre
  // 2026).
  abonos AbonoReposicion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una reposición ABIERTA por proyecto+semana+beneficiario (no "activa" —
  // una liquidada deja de contar, permitiendo una complementaria posterior;
  // ver `cerrada` arriba). No es un @@unique normal a propósito: ni una
  // RECHAZADA ni una ya CERRADA deben bloquear crear una nueva. La garantía
  // real es un índice único PARCIAL en la migración
  // (WHERE cerrada = false AND estatus != 'RECHAZADA'), mismo patrón que la
  // unicidad de APLICACION_ESTIMACION en Control Contractual — no
  // representable en este DSL de Prisma.
  @@map("reposiciones_gastos")
}

// ---------------------------------------------------------------------------
// Compras — Etapa previa a la Orden de Compra (septiembre 2026). Requisición
// = la necesidad detectada en obra/Empresa, sin proveedor ni precio todavía;
// Cotización = una opción comercial de UN proveedor para esa necesidad;
// Orden de Compra = la decisión formal (documento completo, sin relajar sus
// validaciones actuales). Cada etapa referencia a la anterior, nunca la
// vuelve a capturar — "capturar una sola vez".
// ---------------------------------------------------------------------------

enum PrioridadRequisicion {
  NORMAL
  URGENTE
}

enum EstatusRequisicion {
  PENDIENTE
  EN_COTIZACION
  CONVERTIDA
  RECHAZADA
  CANCELADA
}

// La necesidad, tal como la reporta quien está en obra — sin proveedor ni
// precio (eso es Cotizacion/OrdenCompra). Puede ser de un Proyecto real o de
// Empresa (Proyecto tipo OFICINA, mismo mecanismo ya usado en Gastos
// transversal — nunca un segundo concepto de "requisición de empresa").
model Requisicion {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String

  solicitante     Usuario  @relation("RequisicionSolicitada", fields: [solicitantePorId], references: [id])
  solicitantePorId String
  fecha           DateTime @default(now())

  concepto      String
  descripcion   String?
  cantidad      Decimal  @db.Decimal(14, 3)
  unidad        String
  prioridad     PrioridadRequisicion @default(NORMAL)
  fechaRequerida DateTime?
  comentarios   String?

  // Referencia opcional a un Concepto del contrato — nunca obligatoria,
  // muchas necesidades de obra no mapean 1:1 a un concepto contractual.
  conceptoContractual   Concepto? @relation(fields: [conceptoContractualId], references: [id])
  conceptoContractualId String?

  // Evidencia — mismo mecanismo de storage que GastoObra.ticketRef (subirArchivo,
  // lib/server/archivos.ts), un solo archivo, no una galería.
  evidenciaRef    String?
  evidenciaNombre String?

  estatus       EstatusRequisicion @default(PENDIENTE)
  motivoRechazo String?
  revisadoPor   Usuario?  @relation("RequisicionRevisada", fields: [revisadoPorId], references: [id])
  revisadoPorId String?
  revisadoEn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cotizaciones Cotizacion[]
  // La OC generada desde esta Requisición — ver OrdenCompra.requisicionId
  // (el @unique vive ahí, garantiza que una Requisición nunca se convierta
  // en más de una OC).
  ordenCompra  OrdenCompra?

  @@index([empresaId, proyectoId])
  @@index([estatus])
  @@map("requisiciones")
}

// Una opción comercial de UN proveedor para una Requisición — nunca desglose
// por línea (eso lo resuelve OrdenCompraConcepto al formalizar la compra).
// A lo más UNA fila por Requisición puede tener seleccionada = true —
// garantizado por un índice único PARCIAL en la migración
// (WHERE seleccionada = true), no solo un checkbox visual — mismo patrón que
// ReposicionGastos/APLICACION_ESTIMACION, no representable en este DSL de
// Prisma.
model Cotizacion {
  id             String      @id @default(cuid())
  requisicion    Requisicion @relation(fields: [requisicionId], references: [id])
  requisicionId  String

  // Proveedor existente, Beneficiario tipo PROVEEDOR — nunca un catálogo
  // nuevo (mismo criterio que OrdenCompra.proveedorBeneficiarioId).
  proveedor               Beneficiario @relation(fields: [proveedorBeneficiarioId], references: [id])
  proveedorBeneficiarioId String

  importe           Decimal  @db.Decimal(14, 2)
  vigenciaHasta      DateTime?
  tiempoEntregaDias  Int?
  observaciones      String?
  archivoRef         String?
  archivoNombre      String?
  seleccionada       Boolean  @default(false)

  registradoPor   Usuario @relation("CotizacionRegistrada", fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisicionId])
  @@index([proveedorBeneficiarioId])
  @@map("cotizaciones")
}

enum EstatusOrdenCompra {
  BORRADOR
  PENDIENTE_AUTORIZACION
  AUTORIZADA
  RECHAZADA
  CANCELADA
}

// Estatus de recepción del material/servicio — INDEPENDIENTE del pago
// (OrdenCompra.movimientoSemanal.estatusPago). Pueden ocurrir en cualquier
// orden: recibir antes de que el pago se refleje como gasto, o al revés
// (Compras, septiembre 2026).
enum EstatusRecepcionOrdenCompra {
  PENDIENTE
  PARCIAL
  COMPLETA
}

// Compra planeada/autorizada que Conkuali hace directamente a un proveedor —
// no representa un gasto ya realizado por una persona (eso es GastoObra vía
// Reposición). "Pagada" se lee de movimientoSemanal.estatusPago, igual
// criterio que ReposicionGastos — sin estado de pago propio.
model OrdenCompra {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  semana     Semana   @relation(fields: [semanaId], references: [id])
  semanaId   String

  folio       String // OC-000456, único por empresa
  numeroFolio Int

  // Requisición de la que se generó esta OC — null si se creó directo
  // (siempre permitido, no toda compra nace de una requisición formal). El
  // @unique garantiza que una misma Requisición nunca se convierta en más de
  // una OC (Compras, septiembre 2026) — dividir una requisición entre varios
  // proveedores queda fuera de alcance de V1.
  requisicion   Requisicion? @relation(fields: [requisicionId], references: [id])
  requisicionId String?      @unique

  // Proveedor existente, Beneficiario tipo PROVEEDOR — nunca un catálogo
  // nuevo.
  proveedor               Beneficiario @relation(fields: [proveedorBeneficiarioId], references: [id])
  proveedorBeneficiarioId String

  fecha           DateTime
  estatus         EstatusOrdenCompra @default(PENDIENTE_AUTORIZACION)
  metodoPago      MetodoPagoGasto? // previsto; puede no saberse hasta pagar
  requiereFactura Boolean            @default(false)
  notas           String?

  // Recepción — INDEPENDIENTE del pago (movimientoSemanal.estatusPago, abajo)
  // y del Gasto documental (gastosGenerados). Puede completarse antes,
  // después o al mismo tiempo que cualquiera de esos dos (Compras, septiembre
  // 2026).
  estatusRecepcion        EstatusRecepcionOrdenCompra @default(PENDIENTE)
  recibidoEn              DateTime?
  recibidoPor             Usuario?                    @relation("OCRecibida", fields: [recibidoPorId], references: [id])
  recibidoPorId           String?
  evidenciaRecepcionRef   String?
  evidenciaRecepcionNombre String?
  comentarioRecepcion     String?

  // Snapshot al autorizar — una OC ya autorizada es una obligación formal, su
  // total no debe moverse solo porque alguien edite precios del detalle
  // después (igual criterio que EstimacionCliente.total al emitir). Antes de
  // autorizar, el total se deriva en vivo sumando el detalle.
  totalAutorizado Decimal? @db.Decimal(14, 2)

  tratamientoCliente            TratamientoClienteGasto @default(NO_COBRABLE)
  incluidoEnEstimacionClienteId String?

  cotizacionRef         String?
  cotizacionNombre      String?
  comprobantePagoRef    String?
  comprobantePagoNombre String?
  facturaRef            String?
  facturaNombre         String?

  creadoPor       Usuario   @relation("OCCreada", fields: [creadoPorId], references: [id])
  creadoPorId     String
  autorizadoPor   Usuario?  @relation("OCAutorizada", fields: [autorizadoPorId], references: [id])
  autorizadoPorId String?
  autorizadoEn    DateTime?

  movimientoSemanal   MovimientoSemanal? @relation(fields: [movimientoSemanalId], references: [id])
  movimientoSemanalId String?            @unique

  detalle         OrdenCompraConcepto[]
  gastosGenerados GastoObra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ordenes_compra")
}

model OrdenCompraConcepto {
  id            String      @id @default(cuid())
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  ordenCompraId String

  concepto       String
  descripcion    String?
  unidad         String
  cantidad       Decimal @db.Decimal(14, 3)
  precioUnitario Decimal @db.Decimal(14, 2)
  // importe NO se guarda — cantidad × precioUnitario, siempre derivado.

  @@index([ordenCompraId])
  @@map("ordenes_compra_conceptos")
}

// ---------------------------------------------------------------------------
// Módulo Gastos transversal — Proyecto o Empresa, recurrentes, reposiciones
// parciales (septiembre 2026). Un gasto de Empresa sigue siendo un GastoObra
// normal, apuntando al Proyecto(tipo=OFICINA) canónico de esa Empresa — no
// existe ninguna entidad "gasto de empresa" paralela (ver
// lib/server/control-de-obra/proyecto-oficina.ts).
// ---------------------------------------------------------------------------

enum FrecuenciaGasto {
  SEMANAL
  QUINCENAL
  MENSUAL
}

// Plantilla de una obligación recurrente (nómina, renta, gasolina...) — NO es
// un gasto en sí, es el origen que genera ocurrencias reales (GastoObra) de
// forma perezosa e idempotente (ver asegurarGastosRecurrentesGenerados).
// Editar o desactivar esta plantilla nunca reescribe una ocurrencia ya
// generada — cada GastoObra.recurrenteId apunta aquí pero es su propia fila
// independiente para siempre.
model GastoRecurrente {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  empresaId  String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String

  descripcion String
  // Mismo catálogo curado que GastoObra.categoria (lib/control-de-obra/
  // categorias-gasto.ts) — nunca un catálogo propio.
  categoria   String
  frecuencia  FrecuenciaGasto

  // null = monto variable: cada ocurrencia nace en BORRADOR con el monto
  // pendiente de captura, en vez de un campo "montoPendiente" aparte —
  // reutiliza el mismo EstatusGasto.BORRADOR que ya existe en el enum de
  // GastoObra pero que hoy ningún flujo usa (encaja exactamente aquí).
  montoFijo Decimal? @db.Decimal(14, 2)

  // Igual significado que GastoObra.pagadorBeneficiarioId (null = lo paga la
  // empresa directo) — aquí es un FK directo, no un modo "YO/OTRO/EMPRESA",
  // porque al generar una ocurrencia no hay un usuario actual con sesión.
  pagador               Beneficiario? @relation(fields: [pagadorBeneficiarioId], references: [id])
  pagadorBeneficiarioId String?

  fechaInicio DateTime
  activo      Boolean  @default(true)

  creadoPor   Usuario @relation("GastoRecurrenteCreado", fields: [creadoPorId], references: [id])
  creadoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ocurrencias GastoObra[]

  @@index([empresaId, proyectoId])
  @@index([pagadorBeneficiarioId])
  @@map("gastos_recurrentes")
}

// Pago parcial contra una Reposición — permite "Gasto $10,000 / Repuesto
// $6,000 / Pendiente $4,000" sin inventar un estado nuevo en EstatusPago: el
// saldo pendiente (reposicion.total − Σ abonos.monto) se calcula siempre en
// el servicio, nunca se persiste. Cuando el saldo llega a $0 se dispara el
// liquidarMovimiento() normal sobre el MovimientoSemanal de la reposición
// (reposiciones parciales, septiembre 2026).
model AbonoReposicion {
  id                 String           @id @default(cuid())
  reposicion         ReposicionGastos @relation(fields: [reposicionGastosId], references: [id])
  reposicionGastosId String

  monto      Decimal         @db.Decimal(14, 2)
  fecha      DateTime
  metodoPago MetodoPagoGasto
  referencia String?
  notas      String?

  registradoPor   Usuario @relation("AbonoReposicionRegistrado", fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())

  @@index([reposicionGastosId])
  @@map("abonos_reposicion")
}

// ---------------------------------------------------------------------------
// Módulo Contabilidad — Ingresos, Egresos, Facturas pendientes (septiembre
// 2026). Filosofía "capturar una sola vez": Egreso/Ingreso NUNCA duplican
// monto/fecha/concepto/proyecto/pagador de GastoObra/MovimientoFinancieroCliente
// — son una DECORACIÓN fiscal opcional, creada perezosamente solo cuando hay
// información contable real que agregar (medio financiero, factura, notas).
// "Factura pendiente" nunca depende de que exista un Egreso — se deriva
// directamente de GastoObra.requiereFactura (igual criterio que
// calcularEstatusFiscal en gastos.ts), confirmado explícitamente así.
// ---------------------------------------------------------------------------

enum TipoMedioFinanciero {
  BANCO
  TARJETA
  EFECTIVO
}

// Catálogo simple por Empresa — identifica POR QUÉ MEDIO entró/salió el
// dinero (ej. "BBVA — Cuenta fiscal", "Caja / Efectivo"). Deliberadamente sin
// saldos, sin conciliación, sin movimientos propios — solo una etiqueta
// reutilizable en Ingreso.cuentaReceptoraId / Egreso.medioFinancieroId.
model MedioFinanciero {
  id        String              @id @default(cuid())
  empresa   Empresa             @relation(fields: [empresaId], references: [id])
  empresaId String
  nombre    String
  tipo      TipoMedioFinanciero
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  egresos           Egreso[]
  ingresosReceptora Ingreso[]

  @@index([empresaId])
  @@map("medios_financieros")
}

enum MetodoIngreso {
  TRANSFERENCIA
  DEPOSITO
  CHEQUE
  OTRO
}

// Estado compartido por Ingreso/Egreso/Factura — nunca se borra un registro
// financiero, se cancela (mismo criterio que ReposicionGastos/ReciboPago).
enum EstatusRegistroContable {
  VIGENTE
  CANCELADO
}

enum DireccionFactura {
  EMITIDA // Conkuali factura a un cliente (Ingreso) — Conkuali es el RFC emisor
  RECIBIDA // Conkuali recibe la factura de un proveedor (Egreso) — Conkuali es el RFC receptor
}

// CFDI estructurado — la fuente fiscal principal es SIEMPRE el XML (xmlRef);
// el PDF es solo la representación/documento adjunto (nunca se lee por OCR).
// Una Factura puede decorar varios Egresos ("1 factura cubre varios gastos",
// V1) — la relación inversa ("1 gasto con varias facturas") queda para V2,
// necesitaría una tabla de unión con monto por factura (mismo patrón que
// AbonoReposicion) que no se construye todavía.
model Factura {
  id        String  @id @default(cuid())
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId String

  direccion DireccionFactura

  xmlRef    String
  xmlNombre String
  pdfRef    String?
  pdfNombre String?

  // Campos parseados del XML CFDI — nunca recalculados después de cargarse,
  // el XML original (xmlRef) sigue siendo la fuente de verdad si hay dudas.
  uuid                String
  rfcEmisor           String
  razonSocialEmisor   String
  rfcReceptor         String
  razonSocialReceptor String?
  fechaEmision        DateTime
  subtotal            Decimal  @db.Decimal(14, 2)
  totalImpuestos      Decimal  @default(0) @db.Decimal(14, 2)
  total               Decimal  @db.Decimal(14, 2)
  moneda              String
  // MetodoPago = PUE/PPD (forma de exigibilidad); FormaPago = catálogo SAT
  // (01 efectivo, 03 transferencia, etc.) — dos atributos CFDI distintos, se
  // guardan tal cual vienen, sin traducir a nuestro propio enum.
  metodoPago String?
  formaPago  String?
  serie      String?
  folio      String?

  estatus EstatusRegistroContable @default(VIGENTE)

  egresos  Egreso[]
  ingresos Ingreso[]

  subidoPor   Usuario  @relation("FacturaSubida", fields: [subidoPorId], references: [id])
  subidoPorId String
  createdAt   DateTime @default(now())

  // Un UUID de CFDI es único por definición — se hace cumplir por Empresa
  // (aislamiento multiempresa), no globalmente.
  @@unique([empresaId, uuid])
  @@index([empresaId])
  @@map("facturas")
}

// Egreso fiscal — decora un GastoObra existente (gastoObraId, la relación
// común) SIN duplicar nada de él, o representa un egreso manual sin origen
// operativo (gastoObraId null, ej. una comisión bancaria) usando sus propios
// campos. Se crea perezosamente: mientras nadie agregue medio financiero,
// factura o notas contables a un GastoObra fiscalmente relevante
// (requiereFactura = true), no existe ninguna fila aquí — la lista de
// Egresos de Contabilidad se arma leyendo GastoObra directo y decorando con
// esta fila SI existe (Contabilidad, septiembre 2026).
model Egreso {
  id        String  @id @default(cuid())
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId String

  gastoObra   GastoObra? @relation(fields: [gastoObraId], references: [id])
  gastoObraId String?    @unique

  // Solo se usan/requieren cuando gastoObraId es null (egreso manual) — con
  // gastoObraId presente, fecha/concepto/monto/proyecto se LEEN del gasto,
  // nunca se vuelven a capturar aquí.
  fecha      DateTime?
  concepto   String?
  monto      Decimal?  @db.Decimal(14, 2)
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])
  proyectoId String?

  medioFinanciero   MedioFinanciero? @relation(fields: [medioFinancieroId], references: [id])
  medioFinancieroId String?

  factura   Factura? @relation(fields: [facturaId], references: [id])
  facturaId String?

  notasContables String?

  estatus EstatusRegistroContable @default(VIGENTE)

  registradoPor   Usuario  @relation("EgresoRegistrado", fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([facturaId])
  @@index([medioFinancieroId])
  @@map("egresos")
}

// Ingreso fiscal — mismo criterio que Egreso: decora un
// MovimientoFinancieroCliente existente (pago de cliente ya trackeado) sin
// duplicar monto/fecha/proyecto, o representa un ingreso manual sin origen
// previo (ej. un anticipo todavía no ligado a una estimación).
model Ingreso {
  id        String  @id @default(cuid())
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId String

  movimientoFinancieroCliente   MovimientoFinancieroCliente? @relation(fields: [movimientoFinancieroClienteId], references: [id])
  movimientoFinancieroClienteId String?                      @unique

  // Solo se usan/requieren cuando movimientoFinancieroClienteId es null.
  fecha      DateTime?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id])
  proyectoId String?
  monto      Decimal?  @db.Decimal(14, 2)
  concepto   String?
  // Texto libre — no existe catálogo de Clientes con RFC en el sistema
  // (mismo criterio que Proyecto.cliente), fuera de alcance de esta etapa.
  clienteNombre String?

  metodoIngreso     MetodoIngreso?
  cuentaReceptora   MedioFinanciero? @relation(fields: [cuentaReceptoraId], references: [id])
  cuentaReceptoraId String?

  referencia        String?
  comprobanteRef    String?
  comprobanteNombre String?

  factura   Factura? @relation(fields: [facturaId], references: [id])
  facturaId String?

  // Equivalente a GastoObra.requiereFactura — permite derivar "Facturas
  // pendientes" del lado Ingreso con el mismo criterio (sin Egreso/Ingreso
  // materializado de por medio para el lado Gastos; aquí si aplica porque
  // Ingreso manual sí es la única fuente de este dato).
  facturaEsperada Boolean @default(false)

  comentarios String?

  estatus EstatusRegistroContable @default(VIGENTE)

  registradoPor   Usuario  @relation("IngresoRegistrado", fields: [registradoPorId], references: [id])
  registradoPorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([facturaId])
  @@map("ingresos")
}
